# In development, leave blank to use the Vite dev proxy to localhost:5002.
# In production on Vercel (multi-service), leave blank so same-origin relative paths (/api) are used.
# If hosting the backend separately on an external service (e.g. Railway/Render), set to its HTTPS base URL.
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=
VITE_RAZORPAY_KEY_ID=
