# Environment variables — copy this to .env and fill in your values
PORT=5002

# MongoDB Atlas connection string (both MONGO_URI and MONGODB_URI are supported)
MONGO_URI=
MONGODB_URI=

JWT_SECRET=
VITE_GOOGLE_CLIENT_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Comma-separated allowed origins (e.g. https://rentflow-two-murex.vercel.app,http://localhost:5173)
CORS_ORIGIN=
NODE_ENV=production

# Email SMTP service (used for sign-in & password-reset OTP emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Cloudinary media storage (used for listing images, videos, and profile avatars)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MAX_VIDEO_SIZE_MB=100
PLATFORM_FEE_PERCENT=
PLATFORM_WALLET_USER_ID=