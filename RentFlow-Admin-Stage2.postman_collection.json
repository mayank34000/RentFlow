							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Updated User Name\",\n    \"role\": \"customer\",\n    \"isPro\": true,\n    \"kycStatus\": \"approved\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/users/<USER_ID>",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"admin",
								"users",
								"<USER_ID>"
							]
						}
					},
					"response": []
				},
				{
					"name": "Delete User",
